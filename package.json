{
  "name": "seorap",
  "productName": "Seorap",
  "version": "0.3.0",
  "description": "서랍 (Seorap): 이미지, 글, 링크, 파일을 잠시 넣어두는 Windows 트레이 앱. 자동 저장 메모와 마스터 비밀번호 금고 포함.",
  "main": "out/main/index.js",
  "author": "bbjbc",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/bbjbc/seorap",
  "repository": {
    "type": "git",
    "url": "https://github.com/bbjbc/seorap.git"
  },
  "bugs": {
    "url": "https://github.com/bbjbc/seorap/issues"
  },
  "scripts": {
    "compile": "electron-vite build",
    "dev": "electron-vite dev",
    "start": "npm run compile && electron .",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check . && eslint .",
    "sync-version": "node --experimental-strip-types scripts/sync-version.mts",
    "version": "npm run sync-version && git add docs/demo",
    "lint:fix": "biome check --write . && eslint --fix .",
    "format": "biome format --write .",
    "check": "npm run typecheck && npm run lint && npm run sync-version -- --check",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "npm run compile && node out/main/run-tests.js",
    "icons": "npm run compile && electron out/main/gen-icons.js",
    "build": "npm run compile && electron-builder --win",
    "build:dir": "npm run compile && electron-builder --win --dir",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-config-biome": "^2.1.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "dev.boongranii.seorap",
    "productName": "Seorap",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/main/{dev-functional,debug-shots,gen-icons,run-tests}.js",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "서랍 (Seorap)",
      "artifactName": "Seorap-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Seorap-${version}-portable.exe"
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "compression": "maximum"
  }
}
